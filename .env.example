# ============================================================================
#  NexusBot — master environment reference
#  --------------------------------------------------------------------------
#  This root file documents every variable. For local development copy the
#  per-app examples instead:
#     cp apps/server/.env.example apps/server/.env
#     cp apps/web/.env.example    apps/web/.env
#  This root .env is used by docker-compose.
# ============================================================================

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
# Public URL the API is reachable at (used to build the OAuth callback).
SERVER_URL=http://localhost:8080
# Public URL the dashboard is served from (CORS origin + post-login redirect).
CLIENT_URL=http://localhost:5173

# ─── Discord application ────────────────────────────────────────────────────
#  Create one at https://discord.com/developers/applications
#  See docs/SETUP.md for a step-by-step walkthrough.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_CALLBACK_URL=http://localhost:8080/api/auth/callback
# Optional: register slash commands to ONE guild instantly (great for dev).
# Leave blank to register globally (can take up to ~1h to propagate).
DISCORD_DEV_GUILD_ID=
# Comma-separated Discord user IDs that may access the owner-only admin panel.
BOT_OWNER_IDS=

# ─── Database ───────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/nexusbot

# ─── Security (generate long random strings, e.g. `openssl rand -hex 32`) ────
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_another_random_secret

# ─── Frontend build (apps/web) ──────────────────────────────────────────────
VITE_API_URL=http://localhost:8080
